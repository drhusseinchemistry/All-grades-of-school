rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == "hussein.zebary.chemistry96@gmail.com" && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Entity validation helpers
    function isValidUser(data) {
      return data.keys().hasAll(['displayName', 'email', 'role']) &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() <= 150 &&
             data.role in ['student', 'teacher', 'super_admin'];
    }

    function isValidStudyMaterial(data) {
      return data.keys().hasAll(['title', 'type', 'gradeId', 'authorId']) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.type in ['doc', 'presentation', 'quiz', 'video', 'pdf'] &&
             data.gradeId is string && data.gradeId.size() <= 20 &&
             data.authorId is string && data.authorId.size() <= 128;
    }

    // Collection match blocks
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isOwner(userId) && isValidUser(incoming());
      allow update: if isValidId(userId) && (isOwner(userId) || isAdmin()) && isValidUser(incoming()) && incoming().email == existing().email;
      allow delete: if isValidId(userId) && isAdmin();
    }

    match /studyMaterials/{materialId} {
      allow get, list: if true;
      allow create: if isValidId(materialId) && isSignedIn() &&
                       (incoming().authorId == request.auth.uid || isAdmin()) &&
                       isValidStudyMaterial(incoming());
      allow update: if isValidId(materialId) && isSignedIn() &&
                       (existing().authorId == request.auth.uid || isAdmin()) &&
                       incoming().authorId == existing().authorId &&
                       isValidStudyMaterial(incoming());
      allow delete: if isValidId(materialId) && isSignedIn() &&
                       (existing().authorId == request.auth.uid || isAdmin());
    }

    match /admins/{adminId} {
      allow get, list: if isSignedIn();
      allow write: if isAdmin() && isValidId(adminId);
    }
  }
}
